{
  "name": "gladys-meteoblue",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for meteoblue: hourly and daily weather forecasts from the meteoblue Forecast API, rain and frost scene triggers, scene actions, meteogram and dashboard widgets, with a yearly credit budget.",
  "homepage": "https://github.com/William-De71/gladys-meteoblue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-meteoblue.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "meteoblue",
    "weather",
    "forecast",
    "meteogram",
    "home-automation"
  ]
}
